# Paperpulse environment variables. Copy to .env; never commit .env.

# Public application and SQLite persistence
PROJECT_ENV=dev
PROJECT_DIR=/path/to/paperpulse
DATABASE_URL=sqlite:///data/paperpulse.db
PUBLIC_BASE_URL=http://localhost:4000
SESSION_SECRET=replace-with-a-long-random-value
ADMIN_EMAILS=admin@example.com
# Production Compose binds the app to localhost and trusts proxy headers from the host proxy.
FORWARDED_ALLOW_IPS=*
LOG_LEVEL=INFO

# Passwordless email
SMTP_HOST=smtp.example.com
# Port 465 uses implicit TLS automatically; port 587 uses SMTP_STARTTLS.
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=paperpulse@example.com
SMTP_STARTTLS=true
MAGIC_LINK_DEBUG=false

# Codex CLI summarization (default)
LLM_BACKEND=codex_cli
CODEX_HOME=/app/.codex
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=900

# Optional OpenAI Agents SDK fallback (only used with LLM_BACKEND=openai_api)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
