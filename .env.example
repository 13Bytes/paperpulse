# ============================================================
# Paperpulse — environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# "dev" — uses cached pickle files to avoid repeated API calls
# "prod" — always fetches fresh data from ArXiv
PROJECT_ENV=dev

# Absolute path to the repository root on the host
PROJECT_DIR=/path/to/paperpulse

# Model to use for summarisation — any OpenAI model name.
# Examples:
#   gpt-4o
#   gpt-4o-mini
#   o3-mini
OPENAI_MODEL=gpt-4o-mini

# LLM backend:
#   openai_api — use OPENAI_API_KEY + OpenAI Agents SDK (default)
#   codex_cli  — use local Codex CLI auth from CODEX_HOME
LLM_BACKEND=openai_api

# Codex CLI backend settings. Required only when LLM_BACKEND=codex_cli.
# In Docker, this path is mounted to a persistent named volume.
CODEX_HOME=/app/.codex

# Optional Codex model override. Leave empty to use Codex's configured/default model.
CODEX_MODEL=

# Maximum time to wait for each Codex batch/combine call.
CODEX_TIMEOUT_SECONDS=900

# OpenAI API key — https://platform.openai.com/api-keys
# Required when LLM_BACKEND=openai_api.
OPENAI_API_KEY=

# Optional: Mixpanel analytics token for the Jekyll blog
MIXPANEL_TOKEN=
